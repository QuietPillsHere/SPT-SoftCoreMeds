<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>10.0</LangVersion>
		<RootNamespace>SoftCoreMeds</RootNamespace>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<PropertyGroup>
		<SPTLibVersion>4.1</SPTLibVersion>
		<PublishFullLib>false</PublishFullLib>
		<SPTLibPath>..\SPT.Lib\$(SPTLibVersion)</SPTLibPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>$(SPTLibPath)\0Harmony.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="Assembly-CSharp">
			<HintPath>$(SPTLibPath)\Assembly-CSharp.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="BepInEx">
			<HintPath>$(SPTLibPath)\BepInEx.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="bsg.console.core">
			<HintPath>$(SPTLibPath)\bsg.console.core.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="Comfort">
			<HintPath>$(SPTLibPath)\Comfort.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="Sirenix.Serialization">
			<HintPath>$(SPTLibPath)\Sirenix.Serialization.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="ItemComponent.Types">
			<HintPath>$(SPTLibPath)\ItemComponent.Types.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="spt-reflection">
			<HintPath>$(SPTLibPath)\spt-reflection.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="UnityEngine">
			<HintPath>$(SPTLibPath)\UnityEngine.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(SPTLibPath)\UnityEngine.CoreModule.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="UnityEngine.UI">
			<HintPath>$(SPTLibPath)\UnityEngine.UI.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>

		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(SPTLibPath)\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>$(PublishFullLib)</Private>
		</Reference>
	</ItemGroup>
</Project>
